---
import { corDoPartido } from '../lib/cores';
import { pct, pp } from '../lib/formato';
import type { LinhaPartido } from '../lib/tipos';

interface Props { linhas: LinhaPartido[]; legenda: string }
const { linhas, legenda } = Astro.props;
// Precisa de carregarOrdemNacional() no frontmatter da página que usa este componente.
---
<div class="tabela-rolagem">
  <table class="tabela comparativa">
    <caption class="sr">{legenda}</caption>
    <thead>
      <tr><th scope="col">Partido</th><th scope="col" class="num">2022</th><th scope="col" class="num">2026</th><th scope="col" class="num">Variação</th></tr>
    </thead>
    <tbody>
      {linhas.map((l) => (
        <tr>
          <th scope="row"><i class="cor" style={`background:${corDoPartido(l.partido)}`} aria-hidden="true"></i>{l.partido}</th>
          <td class="num">{l.pct_2022 === null ? <><span>—</span> <span class="selo">não disputou em 2022</span></> : pct(l.pct_2022)}</td>
          <td class="num">{l.pct_2026 === null ? <><span>—</span> <span class="selo">não disputou em 2026</span></> : pct(l.pct_2026)}</td>
          <td class="num">{pp(l.delta_pp)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="nota">Porcentagem dos votos válidos. A variação é a diferença em pontos percentuais (p.p.) calculada pelo pipeline; sem comparação quando o partido não concorreu nos dois anos.</p>
<style>
  .comparativa .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .comparativa th[scope="row"] { font-weight: 700; white-space: nowrap; }
  .cor { display: inline-block; width: 12px; height: 12px; border-radius: 3px; margin-right: 0.5rem; vertical-align: -1px; }
  .selo { display: inline-block; font-size: 0.72rem; border: 1.5px solid var(--tinta-3); color: var(--tinta-2); border-radius: 999px; padding: 0 0.45rem; margin-left: 0.25rem; }
</style>
