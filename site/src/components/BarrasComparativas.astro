---
import { corDoPartido } from '../lib/cores';
import { pct, pp } from '../lib/formato';
import { normalizar } from '../lib/busca';
import type { LinhaPartido } from '../lib/tipos';
import TabelaComparativa from './TabelaComparativa.astro';

interface Props {
  linhas: LinhaPartido[];
  /** Título do gráfico, ex.: "Presidente, 1º turno: 2026 contra 2022". */
  titulo: string;
  /** Legenda (caption) da tabela alternativa. */
  legenda: string;
  /** Corte opcional; ordena pelo maior % em qualquer dos anos antes de cortar. */
  max?: number;
  /** Partidos cujos candidatos tiveram os votos de 2026 anulados (inclusive sub judice). */
  anulados2026?: string[];
}
const { linhas, titulo, legenda, max, anulados2026 = [] } = Astro.props;
// Precisa de carregarOrdemNacional() no frontmatter da página que usa este componente.

const maiorPct = (l: LinhaPartido) => Math.max(l.pct_2026 ?? 0, l.pct_2022 ?? 0);
const itens = max ? [...linhas].sort((a, b) => maiorPct(b) - maiorPct(a)).slice(0, max) : linhas;
const topo = Math.max(10, ...itens.map(maiorPct));
const escala = Math.ceil(topo / 10) * 10; // eixo comum, de 0 a `escala`
const largura = (v: number) => `${(v / escala) * 100}%`;
const eixo = [0, 1, 2, 3].map((i) => Math.round(((escala * i) / 3) * 10) / 10);
const rotulo = (v: number) => `${v.toLocaleString('pt-BR', { maximumFractionDigits: 1 })}%`;
const idTabela = `tab-${normalizar(titulo).replace(/ /g, '-')}`; // título único na página
const ausente = (l: LinhaPartido, ano: number) =>
  ano === 2026 && anulados2026.includes(l.partido) ? 'votos anulados em 2026' : `não disputou em ${ano}`;
const diferenca = (l: LinhaPartido) =>
  l.pct_2022 === null ? ausente(l, 2022) : l.pct_2026 === null ? ausente(l, 2026) : pp(l.delta_pp);
const resumo = itens
  .map(
    (l) =>
      `${l.partido} ${l.pct_2026 === null ? ausente(l, 2026) : `${pct(l.pct_2026)} em 2026`} e ${l.pct_2022 === null ? ausente(l, 2022) : `${pct(l.pct_2022)} em 2022`}${l.delta_pp === null ? '' : `, variação de ${pp(l.delta_pp)}`}`,
  )
  .join('; ');
---
{linhas.length === 0 ? (
  <p class="comp-vazio">Sem dados de partidos para montar este gráfico.</p>
) : (
<div class="comp-graf">
  <div class="graf-cab">
    <div>
      <h3>{titulo}</h3>
      <p class="nota">% dos votos válidos, por partido do candidato</p>
    </div>
    <div class="legenda" aria-hidden="true"><span><i class="leg-26"></i>2026</span><span><i class="leg-22"></i>2022</span></div>
  </div>
  <div class="barras" role="img" aria-label={`Gráfico de barras: ${resumo}.`}>
    <div class="grade" aria-hidden="true">
      {[1, 2, 3].map((i) => <i style={`left:${(i / 3) * 100}%`}></i>)}
    </div>
    {itens.map((l) => (
      <div class="linha-p" style={`--c:${corDoPartido(l.partido)}`}>
        <div class="nome"><i></i>{l.partido}<small>{diferenca(l)}</small></div>
        {[{ ano: 2026, v: l.pct_2026 }, { ano: 2022, v: l.pct_2022 }].map(({ ano, v }) => (
          <div class="trilho">
            <div class="area">
              {v === null
                ? <span class="ausente">{ausente(l, ano)}</span>
                : <span class={`barra a${ano - 2000}`} style={`width:${largura(v)}`}></span>}
            </div>
            <span class={`v${ano === 2022 ? ' ano' : ''}`}>{v === null ? '—' : pct(v)}</span>
          </div>
        ))}
      </div>
    ))}
  </div>
  <div class="eixo" aria-hidden="true"><div>{eixo.map((v, i) => <span style={`left:${(i / 3) * 100}%`}>{rotulo(v)}</span>)}</div><div></div></div>
  <div class="acoes">
    <button type="button" class="ver-tabela" aria-expanded="true" aria-controls={idTabela} hidden>Ver como tabela</button>
  </div>
  <div class="tabela-alt" id={idTabela}>
    <TabelaComparativa linhas={linhas} legenda={legenda} anulados2026={anulados2026} />
  </div>
</div>
)}
<script>
  // Com JavaScript, a tabela fica atrás do botão; sem JavaScript, fica sempre visível.
  document.querySelectorAll<HTMLElement>('.comp-graf').forEach((raiz) => {
    const botao = raiz.querySelector<HTMLButtonElement>('.ver-tabela');
    const tabela = raiz.querySelector<HTMLElement>('.tabela-alt');
    if (!botao || !tabela) return;
    const definir = (aberta: boolean) => {
      tabela.hidden = !aberta;
      botao.setAttribute('aria-expanded', String(aberta));
      botao.textContent = aberta ? 'Esconder tabela' : 'Ver como tabela';
    };
    botao.hidden = false;
    botao.addEventListener('click', () => definir(Boolean(tabela.hidden)));
    definir(false);
  });
</script>
<style>
  .comp-vazio { color: var(--tinta-2); font-style: italic; }
  .comp-graf { margin: 1rem 0; max-width: 720px; }
  .graf-cab { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1rem; align-items: end; margin-bottom: 0.9rem; }
  .graf-cab h3 { margin: 0; font-size: var(--t-s); }
  .graf-cab p { margin: 0; }
  .legenda { display: flex; gap: 1rem; font-size: var(--t-xs); color: var(--tinta-2); flex-wrap: wrap; }
  .legenda span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .legenda i { width: 22px; height: 12px; border-radius: 2px; display: inline-block; }
  .leg-26 { background: var(--tinta-2); }
  .leg-22 { background: repeating-linear-gradient(135deg, var(--tinta-2) 0 2px, transparent 2px 5px); box-shadow: inset 0 0 0 1.5px var(--tinta-2); }
  .barras { display: grid; gap: 1.1rem; position: relative; }
  .grade { position: absolute; inset: 0 5.1rem 0 0; pointer-events: none; }
  .grade i { position: absolute; top: 0; bottom: 0; border-left: 1px dashed var(--linha); }
  .linha-p { display: grid; gap: 4px; position: relative; }
  .nome { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; }
  .nome i { width: 12px; height: 12px; border-radius: 3px; background: var(--c); }
  .nome small { font-weight: 400; color: var(--tinta-2); font-size: var(--t-xs); margin-left: auto; }
  .trilho { display: grid; grid-template-columns: 1fr 4.6rem; align-items: center; gap: 0.5rem; }
  .area { position: relative; height: 18px; border-left: 2px solid var(--linha-forte); }
  .barra { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 0 4px 4px 0; min-width: 2px; }
  .barra.a22 { background: repeating-linear-gradient(135deg, var(--c) 0 2.5px, transparent 2.5px 6px); box-shadow: inset 0 0 0 1.5px var(--c); }
  .barra.a26 { background: var(--c); }
  .v { font-size: var(--t-xs); color: var(--tinta); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .v.ano { color: var(--tinta-2); }
  .ausente { font-size: var(--t-xs); color: var(--tinta-2); font-style: italic; padding-left: 0.5rem; line-height: 18px; }
  .eixo { display: grid; grid-template-columns: 1fr 4.6rem; gap: 0.5rem; margin-top: 0.4rem; }
  .eixo div { position: relative; height: 1em; font-size: 0.72rem; color: var(--tinta-3); font-variant-numeric: tabular-nums; }
  .eixo span { position: absolute; transform: translateX(-50%); }
  .eixo span:first-child { transform: none; }
  .eixo span:last-child { transform: translateX(-100%); }
  .acoes { margin-top: 1.25rem; font-size: var(--t-xs); }
  .acoes button { font: inherit; font-weight: 700; color: var(--tinta); background: none; border: 0; padding: 0; text-decoration: underline; text-underline-offset: 0.18em; text-decoration-thickness: 2px; cursor: pointer; min-height: 44px; }
  .tabela-alt[hidden] { display: none; }
</style>
