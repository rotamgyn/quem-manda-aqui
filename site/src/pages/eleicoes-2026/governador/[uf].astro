---
import Layout from '../../../components/Layout.astro';
import Fonte from '../../../components/Fonte.astro';
import ResultadoPrimeiroTurno from '../../../components/ResultadoPrimeiroTurno.astro';
import BarrasComparativas from '../../../components/BarrasComparativas.astro';
import Mapa from '../../../components/Mapa.astro';
import { UFS, lerComparacao, lerMetaObrigatoria, lerMunicipiosUF } from '../../../lib/dados';
import { urlOg } from '../../../lib/cartao';
import { sigla2022 } from '../../../lib/formato';
import { doEstado, noEstado } from '../../../lib/estados';
import { coresDoMapa, corNoMapa } from '../../../lib/cores';
import type { Resultado } from '../../../lib/tipos';
import { montarLegenda, rotuloVencedor } from '../../../lib/mapa';

export function getStaticPaths() {
  return UFS.map((uf) => ({ params: { uf: uf.toLowerCase() } }));
}

const { uf } = Astro.params;
const meta = lerMetaObrigatoria();
const c = lerComparacao(uf!, 'governador');
const de = doEstado(uf!); // "da Bahia", "do Espírito Santo", "de Goiás"
const em = noEstado(uf!); // "na Bahia", "no Espírito Santo", "em Goiás"

type Ano = { cores: Record<string, string>; rotulos: Record<string, string> };
const m22: Ano = { cores: {}, rotulos: {} };
const m26: Ano = { cores: {}, rotulos: {} };
const links: Record<string, string> = {};
const virou: string[] = [];
const sem2022: string[] = [];
const vencedores: string[] = [];
const municipios = lerMunicipiosUF(uf!);
// mesma paleta nos dois mapas: os 3 partidos que mais venceram em 2022 e 2026 somados
const paleta = coresDoMapa(municipios.flatMap((m) => [m.governador?.vencedor_2022 ?? null, m.governador?.vencedor_2026 ?? null]));
for (const m of municipios) {
  const g = m.governador;
  links[m.ibge] = `/eleicoes-2026/municipio/${uf!.toLowerCase()}/${m.slug}/`;
  const v22 = g?.vencedor_2022 ?? null;
  const v26 = g?.vencedor_2026 ?? null;
  const pct = (r: Resultado | null, v: string | null) => r?.candidatos.find((x) => x.partido === v)?.pct ?? null;
  m22.cores[m.ibge] = v22 ? corNoMapa(paleta, v22) : 'var(--outros)';
  m26.cores[m.ibge] = v26 ? corNoMapa(paleta, v26) : 'var(--outros)';
  // 2022: sigla original ("PSC (hoje PODE)") e % da linha do partido, que já soma siglas convertidas
  const l22 = v22 ? g?.partidos.find((l) => l.partido === v22) : undefined;
  m22.rotulos[m.ibge] = rotuloVencedor(m.nome, 2022, v22 && sigla2022(l22, v22), l22?.pct_2022 ?? null);
  m26.rotulos[m.ibge] = rotuloVencedor(m.nome, 2026, v26, pct(g?.r2026 ?? null, v26));
  if (g?.virou === true) virou.push(m.ibge);
  if (!v22) sem2022.push(m.ibge);
  if (v22) vencedores.push(v22);
  if (v26) vencedores.push(v26);
}
const legenda = montarLegenda(vencedores, (p) => corNoMapa(paleta, p));
---
<Layout
  titulo={`Governador ${de} 2026`}
  imagemOg={urlOg(`governador/${uf!.toLowerCase()}`)}
  descricao={`Resultado do 1º turno para governador ${em} em 2026, comparado com 2022 por partido.`}
>
  <div class="pagina wrap">
    <p class="nota"><a href="/eleicoes-2026">Eleições 2026</a></p>
    <h1>Governador {de}</h1>
    <p class="lede">1º turno de 2026, comparado com o 1º turno de 2022, por partido.</p>

    <ResultadoPrimeiroTurno resultado={c.r2026} apuracaoCompleta={c.apuracao_completa} legenda={`Resultado do 1º turno para governador ${em}, 2026`} />

    <h2>Quem venceu em cada município</h2>
    <div class="mapas">
      <Mapa uf={uf!} id={`${uf}-2022`} cores={m22.cores} rotulos={m22.rotulos} links={links} legenda={legenda} destacar={virou} semDados={sem2022}
        rotuloDestaque="O mais votado mudou desde 2022" rotuloSemDados="sem dados de 2022" legendaMapa={`Governador ${de}: partido mais votado em cada município, 1º turno de 2022`} />
      <Mapa uf={uf!} id={`${uf}-2026`} cores={m26.cores} rotulos={m26.rotulos} links={links} legenda={legenda} destacar={virou}
        rotuloDestaque="O mais votado mudou desde 2022" legendaMapa={`Governador ${de}: partido mais votado em cada município, 1º turno de 2026`} />
    </div>

    <h2>O que mudou desde 2022</h2>
    <BarrasComparativas linhas={c.partidos} anulados2026={c.r2026?.anulados.map((a) => a.partido)} titulo={`Governador ${de}, 1º turno: 2026 contra 2022`} legenda={`Porcentagem dos votos válidos por partido para governador ${em}, 2022 e 2026`} />
    {c.volatilidade !== null && <p>Volatilidade de Pedersen no estado: <b>{c.volatilidade.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}</b> (de 0 a 100).</p>}

    <Fonte fonte={`TSE, dados abertos de 2022 e 2026 (arquivo de 2026 gerado em ${meta.fonte_2026_dg_hg})`} atualizadoEm={meta.gerado_em} />
  </div>
</Layout>
<style>
  .mapas { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .mapas { grid-template-columns: 1fr 1fr; } }
</style>
